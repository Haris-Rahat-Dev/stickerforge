# Optional. When set to an existing service-account JSON, server uses firebase-admin.
# When unset, anonymous sf_uid cookies are used so dogfood/deploy works without Firebase.
# FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# Web client config — leave blank for cookie mode (no sign-in screen).
# When all three of API_KEY / PROJECT_ID / APP_ID are set, the sign-in UI is enabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# E2E only — accepts Bearer e2e:<uid> without calling Google. Leave unset in real runs.
# FIREBASE_E2E_BYPASS=1
