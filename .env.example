# Path to the Firebase service-account JSON (server). Never commit this file.
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# Web client config (Firebase console → Project settings → Your apps → Web app).
# These are public values by design; Firebase security comes from Auth + our verify.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# E2E only — accepts Bearer e2e:<uid> without calling Google. Leave unset in real runs.
# FIREBASE_E2E_BYPASS=1
