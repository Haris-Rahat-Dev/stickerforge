<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── brand strip ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pad_screen"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:background="@drawable/bg_logo"
            android:rotation="-3">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_bolt" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.StickerForge.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_title"
                android:textColor="@color/sf_green"
                android:textSize="24sp" />

            <TextView
                style="@style/Text.StickerForge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/brand_tagline" />
        </LinearLayout>

        <TextView
            android:id="@+id/specChip"
            style="@style/Chip.StickerForge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spec_format" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sf_line" />

    <!-- ── work bed ────────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/pad_screen"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingBottom="20dp"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- pack code -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card">

                <ImageView
                    android:layout_width="@dimen/reg_mark_size"
                    android:layout_height="@dimen/reg_mark_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="@null"
                    android:src="@drawable/reg_mark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/pad_card"
                    android:paddingTop="@dimen/pad_card"
                    android:paddingEnd="@dimen/pad_card_end"
                    android:paddingBottom="@dimen/pad_card_end">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.StickerForge.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/code_label" />

                        <TextView
                            android:id="@+id/countChip"
                            style="@style/Chip.StickerForge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spec_count" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/codeInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:fontFamily="@font/plex_mono_semi_bold"
                            android:hint="@string/code_hint"
                            android:importantForAutofill="no"
                            android:inputType="textNoSuggestions"
                            android:letterSpacing="0.08"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:paddingStart="13dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="13dp"
                            android:paddingBottom="12dp"
                            android:textColor="@color/sf_ink"
                            android:textColorHint="@color/sf_muted_dim"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/loadBtn"
                            style="@style/Widget.StickerForge.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:background="@drawable/btn_ghost"
                            android:minHeight="48dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/load_action"
                            android:textColor="@color/btn_ghost_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/codeHelper"
                        style="@style/Text.StickerForge.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/code_helper"
                        android:textColor="@color/sf_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/hostLine"
                        style="@style/Text.StickerForge.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/sf_muted_dim"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- pack header, appears once the manifest is read -->
            <LinearLayout
                android:id="@+id/packCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_card"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/pad_card"
                android:paddingTop="@dimen/pad_card"
                android:paddingEnd="@dimen/pad_card_end"
                android:paddingBottom="@dimen/pad_card_end"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/trayTile"
                    android:layout_width="@dimen/tray_size"
                    android:layout_height="@dimen/tray_size"
                    android:background="@drawable/bg_tile_empty">

                    <ImageView
                        android:id="@+id/trayIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_tray"
                        android:padding="7dp"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/trayBusy"
                        style="@android:style/Widget.ProgressBar.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/sf_amber"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/packName"
                        style="@style/Text.StickerForge.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/packMeta"
                        style="@style/Text.StickerForge.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/whatsappChip"
                        style="@style/Text.StickerForge.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/chip_diecut"
                        android:text="@string/whatsapp_unknown"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- status / progress / failure -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_card"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/pad_card"
                android:paddingTop="@dimen/pad_card"
                android:paddingEnd="@dimen/pad_card_end"
                android:paddingBottom="@dimen/pad_card_end">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        style="@style/Text.StickerForge.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_empty"
                        android:textColor="@color/sf_ink" />

                    <LinearLayout
                        android:id="@+id/progressRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/overallBar"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="7dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_stamp" />

                        <TextView
                            android:id="@+id/progressCount"
                            style="@style/Text.StickerForge.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/sf_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/errorRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/errorDetail"
                            style="@style/Text.StickerForge.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_inset"
                            android:padding="11dp"
                            android:textColor="@color/sf_red"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/retryBtn"
                            style="@style/Widget.StickerForge.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:background="@drawable/btn_ghost"
                            app:drawableStartCompat="@drawable/ic_retry"
                            android:drawablePadding="6dp"
                            android:minHeight="44dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/retry_action"
                            android:textColor="@color/btn_ghost_text" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- the pack itself, on a dashed die-cut sheet -->
            <LinearLayout
                android:id="@+id/packSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_diecut"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="11dp"
                android:paddingEnd="12dp"
                android:paddingBottom="13dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.StickerForge.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/grid_label" />

                    <TextView
                        android:id="@+id/gridCount"
                        style="@style/Text.StickerForge.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sf_green" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stickerGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="-5dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <TextView
                android:id="@+id/animationNote"
                style="@style/Text.StickerForge.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_inset"
                android:padding="11dp"
                android:text="@string/animation_note"
                android:textColor="@color/sf_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ── action bar ──────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sf_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/addReason"
            style="@style/Text.StickerForge.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_reason_missing"
            android:textColor="@color/sf_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/addBtn"
            style="@style/Widget.StickerForge.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_primary"
            android:enabled="false"
            android:minHeight="54dp"
            android:text="@string/add_action"
            android:textColor="@color/btn_primary_text" />
    </LinearLayout>
</LinearLayout>
