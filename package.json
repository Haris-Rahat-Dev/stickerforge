{
  "name": "stickerforge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp video sticker maker — trim, crop, compress to spec-compliant WebM/VP9",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "start": "node server/dist/index.js",
    "test": "node --test server/test/ web/test/",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "puppeteer-core": "^25.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
